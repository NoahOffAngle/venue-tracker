# Auto detect text files and perform LF normalization
* text=auto

# data/events.json is written by the scraper 4x a day, so your copy and
# GitHub's copy will almost always differ. There's nothing to merge — the next
# scrape rewrites the whole file — so always keep your own version instead of
# stopping with a conflict. (Needs this one-time setup per computer:
#   git config merge.keep-mine.driver true
# Without it git just falls back to asking, which is harmless.)
data/events.json merge=keep-mine
